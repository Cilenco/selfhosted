[Unit]
Description=Jellyfin streming server

[Service]
ExecStartPre=sh jellyfin/jellyfin.bootstrap

[Container]
Image=docker.io/jellyfin/jellyfin:latest@sha256:78d3ea1207d1322471fcac39a614f004f2ccf7e878f95ab2977d752f07e4dd7e

HostName=Jellyfin
ContainerName=jellyfin
Network=caddy

User=65534:65534
NoNewPrivileges=true
DropCapability=all
ReadOnly=true

UserNS=keep-id:uid=65534,gid=65534

Volume=${VOLUMES_DIR}/jellyfin/cache:/cache
Volume=${VOLUMES_DIR}/jellyfin/config:/config

Volume=${MEDIA_DIR}:/media:ro
