[Unit]
Description=Jellyfin streming server

[Service]
ExecStartPre=sh jellyfin/jellyfin.bootstrap

[Container]
Image=docker.io/jellyfin/jellyfin:latest

HostName=Jellyfin
ContainerName=jellyfin
AutoUpdate=registry
Network=caddy

Volume=${VOLUMES_DIR}/jellyfin/app/cache:/cache:idmap
Volume=${VOLUMES_DIR}/jellyfin/app/config:/config:idmap

Volume=${MEDIA_DIR}:/media:ro,idmap
