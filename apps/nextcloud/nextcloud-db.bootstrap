#!/usr/bin/env bash
# set -euo pipefail; umask 077

OWNER=999:999

mkdir -p $VOLUMES_DIR/nextcloud/db
chown $OWNER $VOLUMES_DIR/nextcloud/db

printf $(openssl rand -hex  8) | podman secret create NEXTCLOUD_DB_USERNAME - | true
printf $(openssl rand -hex 12) | podman secret create NEXTCLOUD_DB_PASSWORD - | true
