[Unit]
Description=Adguard Home server

[Service]
ExecStartPre=sh adguard/adguard.bootstrap

[Container]
Image=docker.io/adguard/adguardhome:latest@sha256:aba9e3bf0613be3ba3755e1fc311b126e2c24bec25e18b6483894a88283074f0

HostName=Adguard
ContainerName=adguard
Network=caddy

User=65534:65534
NoNewPrivileges=true
DropCapability=all
ReadOnly=true

UserNS=keep-id:uid=65534,gid=65534

# Required by guard binary
AddCapability=CAP_NET_BIND_SERVICE

PublishPort=127.0.0.1:53:5300/tcp
PublishPort=127.0.0.1:53:5300/udp

PublishPort=${IP_ADDRESS}:53:5300/tcp
PublishPort=${IP_ADDRESS}:53:5300/udp

Volume=${VOLUMES_DIR}/adguard/conf:/opt/adguardhome/conf
Volume=${VOLUMES_DIR}/adguard/work:/opt/adguardhome/work
