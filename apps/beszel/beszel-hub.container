[Unit]
Description=Beszel Hub

[Service]
ExecStartPre=sh beszel/beszel-hub.bootstrap

[Container]
Image=docker.io/henrygd/beszel:latest

ContainerName=beszel-hub
Pod=beszel.pod

HealthCmd=/beszel health --url http://localhost:8090
HealthStartPeriod=5s
HealthInterval=120s
#HealthTimeout=30s
#HealthRetries=3

Environment=APP_URL=http://localhost:8090

Volume=${VOLUMES_DIR}/beszel/hub:/beszel_data
