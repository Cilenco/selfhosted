#!/bin/bash

mkdir -p $VOLUMES_DIR/lldap/data
chown 65534:65534 $VOLUMES_DIR/lldap/data

printf $(openssl rand -hex 64) | podman secret create LDAP_JWT_KEY -  | true
printf $(openssl rand -hex 12) | podman secret create LDAP_USERNAME - | true
printf $(openssl rand -hex 48) | podman secret create LDAP_PASSWORD - | true
printf $(openssl rand -hex 64) | podman secret create LDAP_KEY_SEED - | true
