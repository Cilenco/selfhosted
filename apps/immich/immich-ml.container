[Unit]
Description=Immich ML server

[Service]
ExecStartPre=sh immich/immich-ml.bootstrap

[Container]
Image=ghcr.io/immich-app/immich-machine-learning:release-openvino@sha256:7dd945dcea8f5feb3eb4a21af9c92f2957e991a950372e3ea1c846371dab0406

ContainerName=immich-ml
Pod=immich.pod

User=65534:65534
NoNewPrivileges=true
DropCapability=all
ReadOnly=true

UserNS=keep-id:uid=65534,gid=65534

Environment=MACHINE_LEARNING_MODEL_REVISION=v2

Volume=${VOLUMES_DIR}/immich/ml/cache:/cache
AddDevice=/dev/dri:/dev/dri
