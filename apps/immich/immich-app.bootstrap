#!/usr/bin/env bash
umask 077

mkdir -p $VOLUMES_DIR/immich/app/backups
mkdir -p $VOLUMES_DIR/immich/app/encoded-video
mkdir -p $VOLUMES_DIR/immich/app/profile
mkdir -p $VOLUMES_DIR/immich/app/thumbs
mkdir -p $VOLUMES_DIR/immich/app/upload

mkdir -p "${MEDIA_DIR}2"

(envsubst < $PWD/immich/settings.json) > $VOLUMES_DIR/immich/app/settings.json
