[Unit]
Description=Immich Redis

[Service]
ExecStartPre=sh immich/immich-cache.bootstrap

[Container]
Image=docker.io/redis:alpine@sha256:3811787313eba226a2ef38658c6ccb91cd5e110edc89c37767de373120a0e5a0

User=65534:65534

ContainerName=immich-cache
AutoUpdate=registry
Pod=immich.pod

HealthCmd="redis-cli ping | grep PONG"
HealthStartPeriod=1m20s
HealthInterval=30s
HealthTimeout=30s
HealthRetries=3

Volume=${VOLUMES_DIR}/immich/cache:/data:idmap
